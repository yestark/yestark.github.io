---
import RedirectLayout from '../../layouts/RedirectLayout.astro';
import { getPublishedArticles } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getPublishedArticles('zh');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { destination: `/articles/${entry.id}/` } }));
}
const { destination } = Astro.props as { destination: string };
---
<RedirectLayout destination={destination} title="文章已移动 — Stark Ye" language="zh" />
