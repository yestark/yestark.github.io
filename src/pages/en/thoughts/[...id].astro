---
import RedirectLayout from '../../../layouts/RedirectLayout.astro';
import { getPublishedArticles } from '../../../lib/content';

export async function getStaticPaths() {
  const entries = await getPublishedArticles('en');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { destination: `/en/articles/${entry.id}/` } }));
}
const { destination } = Astro.props as { destination: string };
---
<RedirectLayout destination={destination} title="Article moved — Stark Ye" language="en" />
