---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSiteCopy } from '../../lib/site-content';

const copy = (await getSiteCopy('en')).about;
const sectionOrder = ['background', 'focus', 'capabilities', 'principle', 'status'] as const;
---

<BaseLayout language="en" page="about" title="About Stark Ye" description={copy.body} languageSwitchHref="/about/" alternateHref="/about/">
  <article class="shell about-page">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1>{copy.title}</h1>
    <p>{copy.body}</p>
    {sectionOrder.map((key) => {
      const section = copy.sections[key];
      if (!section) return null;
      return (
        <section aria-labelledby={`${key}-title`}>
          <h2 id={`${key}-title`}>{section.title}</h2>
          {section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}
          {!section.items && <p>{section.body}</p>}
        </section>
      );
    })}
  </article>
</BaseLayout>

<style>
  .about-page { max-width: var(--reading-width); padding-block: clamp(3rem, 8vw, 6rem); }
  .eyebrow { margin: 0 0 0.75rem; }
  h1 { margin: 0; font-size: clamp(2.5rem, 7vw, 4.75rem); line-height: 1.06; letter-spacing: -0.055em; }
  h1 + p { margin: 1.5rem 0 0; color: var(--color-muted); font-size: 1.125rem; line-height: 1.75; }
  section { margin-top: 2.25rem; padding-top: 1.25rem; border-top: 1px solid var(--color-line); }
  h2 { margin: 0; font-size: 1rem; }
  ul { display: grid; gap: 0.5rem; margin: 1rem 0 0; padding: 0; list-style: none; color: var(--color-muted); line-height: 1.6; }
  ul li::before { margin-right: 0.5rem; color: var(--color-accent); content: '—'; }
  section p { margin: 1rem 0 0; color: var(--color-muted); line-height: 1.75; }
</style>
