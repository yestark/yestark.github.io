---
import BaseLayout from './BaseLayout.astro';
import type { Language, StaticPage } from '../i18n/types';

interface Props {
  language: Language;
  page: Extract<StaticPage, 'thoughts' | 'projects'>;
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date | undefined;
  tags: string[];
  languageSwitchHref: string;
  alternateHref?: string | undefined;
}

const props = Astro.props;
const locale = props.language === 'zh' ? 'zh-CN' : 'en';
---

<BaseLayout language={props.language} page={props.page} title={`${props.title} — Stark Ye`} description={props.description} languageSwitchHref={props.languageSwitchHref} alternateHref={props.alternateHref}>
  <article class="content shell">
    <header>
      <p class="eyebrow">{props.page}</p>
      <h1>{props.title}</h1>
      <p class="description">{props.description}</p>
      <div class="metadata">
        <time datetime={props.publishedAt.toISOString()}>{props.publishedAt.toLocaleDateString(locale)}</time>
        {props.updatedAt && <span>{props.language === 'zh' ? '更新于' : 'Updated'} {props.updatedAt.toLocaleDateString(locale)}</span>}
        <span class="content-language">{props.language === 'zh' ? '内容语言：中文' : 'Content language: English'}</span>
      </div>
      <ul aria-label={props.language === 'zh' ? '标签' : 'Tags'}>{props.tags.map((tag) => <li>{tag}</li>)}</ul>
    </header>
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>

<style>
  .content {
    width: min(var(--reading-width), calc(100% - 2rem));
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  header { margin-bottom: 3rem; }
  .eyebrow { margin: 0 0 0.75rem; }
  h1 { margin: 0; font-size: clamp(2.5rem, 7vw, 4.75rem); letter-spacing: -0.055em; line-height: 1; }
  .description { margin: 1.25rem 0; color: var(--color-muted); font-size: 1.125rem; line-height: 1.65; }
  .metadata { display: flex; flex-wrap: wrap; gap: 0.75rem; color: var(--color-muted); font-size: 0.9rem; }
  ul { display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin: 1.25rem 0 0; list-style: none; }
  li { padding: 0.3rem 0.65rem; border-radius: 999px; background: var(--color-accent-soft); color: var(--color-accent); font-size: 0.8rem; font-weight: 700; }

  .prose { font-size: 1.0625rem; line-height: 1.8; }
  .prose :global(h2), .prose :global(h3), .prose :global(h4) { margin-top: 2.5em; line-height: 1.2; letter-spacing: -0.035em; }
  .prose :global(h2) { font-size: 1.9em; }
  .prose :global(h3) { font-size: 1.45em; }
  .prose :global(h4) { font-size: 1.2em; }
  .prose :global(a) { color: var(--color-accent); text-decoration: underline; text-decoration-thickness: 0.12em; text-underline-offset: 0.16em; }
  .prose :global(pre) { max-width: 100%; overflow-x: auto; padding: 1rem; border: 1px solid var(--color-line); border-radius: var(--radius-sm); background: var(--color-surface-2); color: var(--color-ink); white-space: pre-wrap; overflow-wrap: anywhere; }
  .prose :global(code) { overflow-wrap: anywhere; }
  .prose :global(:not(pre) > code) { padding: 0.15em 0.35em; border-radius: 0.25rem; background: var(--color-accent-soft); }
  .prose :global(img), .prose :global(video), .prose :global(iframe) { max-width: 100%; height: auto; }
  .prose :global(table) { display: block; max-width: 100%; overflow-x: auto; border-collapse: collapse; }
  .prose :global(th), .prose :global(td) { padding: 0.6rem; border: 1px solid var(--color-line); text-align: left; }
</style>
