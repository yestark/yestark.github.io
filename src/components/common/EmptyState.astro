---
interface Props {
  title: string;
  body: string;
  marker?: string;
}

const { title, body, marker = '✦' } = Astro.props;
---

<div class="empty-state" data-empty-state>
  <span aria-hidden="true">{marker}</span>
  <div>
    <h2>{title}</h2>
    <p>{body}</p>
  </div>
</div>

<style>
  .empty-state {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    min-height: 12rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border: 1px dashed var(--color-line);
    border-radius: var(--radius-md);
    background:
      linear-gradient(rgb(232 184 79 / 3%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(232 184 79 / 3%) 1px, transparent 1px),
      color-mix(in srgb, var(--color-surface) 82%, transparent);
    background-size: 2rem 2rem;
  }

  .empty-state > span {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--color-line-strong);
    background: var(--color-page);
    color: var(--color-accent);
  }

  h2,
  p { margin: 0; }

  h2 { font-size: 1.15rem; letter-spacing: -0.02em; }

  p {
    margin-top: 0.35rem;
    color: var(--color-muted);
    line-height: 1.6;
  }
</style>
