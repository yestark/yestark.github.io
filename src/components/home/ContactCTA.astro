---
import { siteConfig } from '../../config/site';
import type { Language } from '../../i18n/types';
import { getSiteCopy } from '../../lib/site-content';

const { language } = Astro.props as { language: Language };
const copy = (await getSiteCopy(language)).contact;
---

<section id="contact" class="contact-section shell" data-section="contact">
  <div>
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2>{copy.title}</h2>
    <p>{copy.body}</p>
  </div>
  <a class="button" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
</section>

<style>
  .contact-section {
    display: flex;
    gap: 2rem;
    align-items: center;
    justify-content: space-between;
    margin-block: 4.5rem;
    padding: clamp(2.5rem, 7vw, 4.5rem);
    border: 1px solid var(--color-accent-bright);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--color-accent-bright), var(--color-accent));
    color: #070806;
  }

  .eyebrow { margin: 0 0 0.75rem; color: #302305; }
  h2 { max-width: 17ch; margin: 0; font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1.03; letter-spacing: -0.05em; }
  p:not(.eyebrow) { max-width: 37rem; margin: 1rem 0 0; color: #241a04; line-height: 1.7; }
  .button { display: inline-flex; flex: none; padding: 0.9rem 1.1rem; border-radius: 999px; background: #070806; color: var(--color-ink); font-weight: 800; }
  .button:hover { transform: translateY(-1px); }

  @media (max-width: 48rem) {
    .contact-section { align-items: flex-start; flex-direction: column; }
    .button { width: 100%; justify-content: center; }
  }
</style>
